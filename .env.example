# Copy to .env (or paste these as stack environment variables in Portainer).

# Connection string for your existing PostgreSQL. Use a database and a role
# dedicated to this app rather than one shared with anything else. When the
# database runs as another container on the same Docker network, the host is
# its container name; otherwise use its host and port.
DATABASE_URL=postgres://wwm:CHANGE_ME@192.168.1.80:5433/wwm_db

# Set to true only if your PostgreSQL requires TLS.
DATABASE_SSL=false

# How many PostgreSQL connections the API may hold. The default suits a guild
# of any size; raise it only if the log starts reporting connection timeouts,
# and never above what your PostgreSQL itself allows.
DATABASE_POOL_MAX=30

# Identifies this guild's rows. Change it if you ever host a second guild
# against the same database.
GUILD_ID=default-guild
GUILD_NAME=My Guild

# Host port the web UI is published on.
WEB_PORT=8085

# Signs session cookies. Leave empty and one is generated and stored in the
# database, so restarts do not sign everyone out. Changing it ends all sessions.
SESSION_SECRET=

# Set to true once the app is reached over HTTPS.
COOKIE_SECURE=false

# Used only to create the first administrator, when the guild has no accounts.
# Leave the password empty and a random one is printed once in the API log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signing in with Discord. Create an application at discord.com/developers,
# then add <PUBLIC_URL>/api/auth/discord/callback as an OAuth2 redirect.
# Leave these empty and the Discord button is not offered at all.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The guild's Discord bot: same application, Bot tab, "Reset Token". It must be
# invited to the guild's Discord server (see DEPLOY.md). DISCORD_GUILD_ID is
# the server's id, copied with developer mode on. Leave these empty and the
# admin panel simply does not offer linking members from Discord.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Slash commands (/perfil). The public key is on the application's "General
# Information" page, and it is what proves an incoming command really came from
# Discord. Set it, then paste <PUBLIC_URL>/api/discord/interactions into that
# same page as the Interactions Endpoint URL. Leave it empty and the endpoint
# answers 503 and no commands are registered.
DISCORD_PUBLIC_KEY=

# Where members reach the app from outside your network. Discord sends them
# back here, so a LAN address only works for people already on that network.
PUBLIC_URL=https://gremio.tudominio.com

# Solo para desarrollo: apunta el servidor de Vite a un despliegue en marcha
# para trabajar la interfaz contra datos reales sin levantar la API en local.
# API_PROXY=https://zonazero.blkdrg.com
